{
  "name": "image-uploader",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve",
    "build": "npm run build:lib && ng build image-uploader",
    "watch": "ng build --watch --configuration development",
    "test": "npm run build:lib && ng test",
    "build:lib": "ng build angular-material-image-uploader",
    "pack:lib": "npm run build:lib && cd dist/angular-material-image-uploader && npm pack --dry-run",
    "publish:lib": "npm run build:lib && cd dist/angular-material-image-uploader && npm publish"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "ngx-image-cropper": "^9.1.7",
    "ngx-toastr": "^20.0.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "jsdom": "^30.0.1",
    "ng-packagr": "^22.2.4",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
